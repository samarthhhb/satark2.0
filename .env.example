# ====================================================================
# SATARK 2.0 - Environment Configuration Template
# ====================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit the actual .env file with real secrets to version control.
#
# GitHub & AWS Deployment Note:
# - On GitHub: Set secrets in Settings -> Secrets and variables -> Actions
# - On AWS (EC2 / ECS / Elastic Beanstalk / Lambda / App Runner):
#   Set these in AWS Systems Manager (SSM) Parameter Store or Secrets Manager
# ====================================================================

# 1. Database Configuration
DATABASE_URL=sqlite:///./satark.db
# DATABASE_URL=postgresql://satark_admin:YourSecurePassword@satark-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/satark

# 2. Authentication & JWT Security
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Machine Learning Model & Dataset Paths
MODEL_PATH=app/ml/forecaster.cbm
RISK_MODEL_PATH=app/ml/risk_classifier.cbm
DATA_PATH=../data/district_profiles.csv

# 4. CyberGuard AI Threat Intelligence (Groq API Key)
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
